  <style>
    :root {
      --gold: #c9a227;
      --gold-light: #e7c75f;
      --gold-dark: #8c6814;
      --black: #101010;
      --dark: #1b1b1b;
      --white: #ffffff;
      --cream: #f8f5ee;
      --gray: #6d6d6d;
      --shadow: 0 10px 35px rgba(0, 0, 0, 0.10);
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      scroll-behavior: smooth;
    }

    body {
      font-family: "Poppins", sans-serif;
      color: var(--black);
      background: var(--white);
      overflow-x: hidden;
    }

    h1, h2, h3 {
      font-family: "Cormorant Garamond", serif;
    }

    a {
      text-decoration: none;
    }

    img {
      width: 100%;
      display: block;
    }

    .container {
      width: min(1140px, 90%);
      margin: auto;
    }

    .section {
      padding: 90px 0;
    }

    .section-title {
      text-align: center;
      margin-bottom: 50px;
    }

    .section-title span {
      color: var(--gold-dark);
      text-transform: uppercase;
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 2px;
    }

    .section-title h2 {
      font-size: clamp(38px, 5vw, 55px);
      margin-top: 8px;
    }

    .section-title p {
      max-width: 650px;
      margin: 15px auto 0;
      color: var(--gray);
      line-height: 1.8;
    }

    /* NAVBAR */
    header {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      z-index: 1000;
      transition: 0.3s;
    }

    header.scrolled {
      background: rgba(16, 16, 16, 0.97);
      box-shadow: 0 5px 25px rgba(0, 0, 0, 0.2);
    }

    .navbar {
      height: 78px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 12px;
      color: var(--white);
      font-weight: 700;
      font-size: 18px;
    }

    .logo-icon {
      width: 45px;
      height: 45px;
      border: 1px solid var(--gold);
      border-radius: 50%;
      display: grid;
      place-items: center;
      color: var(--gold-light);
      font-size: 20px;
    }

    .logo-text small {
      display: block;
      font-size: 9px;
      letter-spacing: 3px;
      color: var(--gold-light);
      font-weight: 500;
    }

    nav ul {
      list-style: none;
      display: flex;
      gap: 28px;
    }

    nav ul a {
      color: var(--white);
      font-size: 13px;
      transition: 0.3s;
    }

    nav ul a:hover {
      color: var(--gold-light);
    }

    .nav-contact {
      padding: 10px 18px;
      border: 1px solid var(--gold);
      color: var(--gold-light) !important;
    }

    .menu-btn {
      display: none;
      color: white;
      font-size: 24px;
      cursor: pointer;
    }

    /* HERO */
    .hero {
      min-height: 100vh;
      background:
        linear-gradient(90deg, rgba(0,0,0,.85), rgba(0,0,0,.45)),
        url("https://images.unsplash.com/photo-1605100804763-247f67b3557e?auto=format&fit=crop&w=1600&q=85")
        center/cover;
      display: flex;
      align-items: center;
      color: white;
    }

    .hero-content {
      max-width: 720px;
      padding-top: 80px;
    }

    .hero-tag {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      color: var(--gold-light);
      font-size: 13px;
      letter-spacing: 2px;
      text-transform: uppercase;
      margin-bottom: 20px;
    }

    .hero-tag::before {
      content: "";
      width: 40px;
      height: 1px;
      background: var(--gold);
    }

    .hero h1 {
      font-size: clamp(52px, 7vw, 85px);
      line-height: 0.95;
      font-weight: 700;
      margin-bottom: 25px;
    }

    .hero h1 span {
      color: var(--gold-light);
    }

    .hero p {
      max-width: 600px;
      line-height: 1.9;
      color: #dddddd;
      font-size: 16px;
    }

    .hero-buttons {
      display: flex;
      gap: 15px;
      flex-wrap: wrap;
      margin-top: 35px;
    }

    .btn {
      padding: 14px 25px;
      display: inline-block;
      font-size: 13px;
      font-weight: 600;
      transition: 0.3s;
    }

    .btn-gold {
      background: var(--gold);
      color: var(--black);
    }

    .btn-gold:hover {
      background: var(--gold-light);
      transform: translateY(-3px);
    }

    .btn-outline {
      border: 1px solid rgba(255,255,255,.7);
      color: white;
    }

    .btn-outline:hover {
      background: white;
      color: black;
    }

    /* ABOUT */
    .about {
      background: var(--cream);
    }

    .about-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 60px;
      align-items: center;
    }

    .about-image {
      position: relative;
    }

    .about-image img {
      height: 550px;
      object-fit: cover;
    }

    .about-badge {
      position: absolute;
      right: -20px;
      bottom: 30px;
      width: 170px;
      padding: 25px;
      background: var(--black);
      color: white;
      text-align: center;
    }

    .about-badge strong {
      display: block;
      color: var(--gold-light);
      font-size: 35px;
      font-family: "Cormorant Garamond", serif;
    }

    .about-content span {
      color: var(--gold-dark);
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 2px;
    }

    .about-content h2 {
      font-size: 50px;
      margin: 10px 0 20px;
      line-height: 1;
    }

    .about-content p {
      color: var(--gray);
      line-height: 1.9;
      margin-bottom: 20px;
    }

    .about-list {
      list-style: none;
      margin-top: 25px;
    }

    .about-list li {
      margin: 14px 0;
      font-size: 14px;
    }

    .about-list i {
      color: var(--gold-dark);
      margin-right: 10px;
    }

    /* PRODUCTS */
    .products-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 25px;
    }

    .product-card {
      background: white;
      box-shadow: var(--shadow);
      transition: 0.4s;
      overflow: hidden;
    }

    .product-card:hover {
      transform: translateY(-10px);
    }

    .product-image {
      height: 280px;
      overflow: hidden;
    }

    .product-image img {
      height: 100%;
      object-fit: cover;
      transition: 0.5s;
    }

    .product-card:hover img {
      transform: scale(1.08);
    }

    .product-info {
      padding: 22px;
    }

    .product-info h3 {
      font-size: 28px;
      margin-bottom: 8px;
    }

    .product-meta {
      color: var(--gray);
      font-size: 12px;
      margin-bottom: 18px;
    }

    .product-btn {
      display: inline-block;
      font-size: 12px;
      color: var(--gold-dark);
      font-weight: 700;
      border-bottom: 1px solid var(--gold);
      padding-bottom: 5px;
    }

    /* FEATURES */
    .features {
      background: var(--black);
      color: white;
    }

    .features .section-title p {
      color: #aaa;
    }

    .features-grid {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 20px;
    }

    .feature-card {
      text-align: center;
      padding: 30px 15px;
      border: 1px solid rgba(255,255,255,.12);
      transition: 0.3s;
    }

    .feature-card:hover {
      border-color: var(--gold);
      transform: translateY(-5px);
    }

    .feature-card i {
      color: var(--gold-light);
      font-size: 35px;
      margin-bottom: 18px;
    }

    .feature-card h3 {
      font-size: 24px;
    }

    /* GOLD PRICE */
    .price-section {
      background: linear-gradient(135deg, #f6f0df, #ffffff);
    }

    .price-box {
      max-width: 900px;
      margin: auto;
      background: white;
      box-shadow: var(--shadow);
      border-top: 4px solid var(--gold);
    }

    .price-header {
      background: var(--black);
      color: white;
      padding: 25px 30px;
      display: flex;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 10px;
    }

    .price-header h3 {
      font-size: 30px;
    }

    .price-header p {
      font-size: 12px;
      color: #bbb;
    }

    .price-table {
      width: 100%;
      border-collapse: collapse;
    }

    .price-table th,
    .price-table td {
      padding: 18px 25px;
      text-align: left;
      border-bottom: 1px solid #eee;
      font-size: 14px;
    }

    .price-table th {
      background: #fafafa;
    }

    .price-table td strong {
      color: var(--gold-dark);
    }

    .price-note {
      padding: 18px 25px;
      font-size: 12px;
      color: var(--gray);
      background: #fffdf7;
    }

    /* TESTIMONIAL */
    .testimonial-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 25px;
    }

    .testimonial {
      padding: 30px;
      background: var(--cream);
      border-left: 3px solid var(--gold);
    }

    .testimonial .stars {
      color: var(--gold);
      margin-bottom: 15px;
    }

    .testimonial p {
      color: var(--gray);
      line-height: 1.8;
      font-size: 14px;
      font-style: italic;
    }

    .customer {
      margin-top: 20px;
    }

    .customer strong {
      display: block;
    }

    .customer small {
      color: var(--gold-dark);
    }

    /* CONTACT */
    .contact {
      background: var(--cream);
    }

    .contact-grid {
      display: grid;
      grid-template-columns: .9fr 1.1fr;
      gap: 40px;
    }

    .contact-info {
      background: var(--black);
      color: white;
      padding: 45px;
    }

    .contact-info h2 {
      font-size: 45px;
      margin-bottom: 20px;
    }

    .contact-info > p {
      color: #bbb;
      line-height: 1.8;
      margin-bottom: 30px;
    }

    .contact-item {
      display: flex;
      gap: 15px;
      margin-bottom: 25px;
    }

    .contact-item i {
      color: var(--gold-light);
      font-size: 20px;
      width: 25px;
      margin-top: 3px;
    }

    .contact-item strong {
      display: block;
      margin-bottom: 5px;
    }

    .contact-item p {
      color: #bbb;
      font-size: 13px;
      line-height: 1.6;
    }

    .map-box iframe {
      width: 100%;
      height: 100%;
      min-height: 480px;
      border: 0;
    }

    /* FOOTER */
    footer {
      background: #090909;
      color: white;
      padding: 60px 0 20px;
    }

    .footer-grid {
      display: grid;
      grid-template-columns: 2fr 1fr 1fr;
      gap: 40px;
      padding-bottom: 40px;
    }

    .footer-about p {
      color: #999;
      line-height: 1.8;
      font-size: 13px;
      margin-top: 20px;
      max-width: 400px;
    }

    .footer-title {
      color: var(--gold-light);
      font-family: "Poppins", sans-serif;
      font-size: 14px;
      margin-bottom: 20px;
    }

    .footer-links a {
      display: block;
      color: #999;
      font-size: 13px;
      margin: 10px 0;
      transition: 0.3s;
    }

    .footer-links a:hover {
      color: var(--gold-light);
      padding-left: 5px;
    }

    .socials {
      display: flex;
      gap: 10px;
      margin-top: 20px;
    }

    .socials a {
      width: 38px;
      height: 38px;
      display: grid;
      place-items: center;
      border: 1px solid #444;
      color: var(--gold-light);
      transition: 0.3s;
    }

    .socials a:hover {
      background: var(--gold);
      color: black;
    }

    .copyright {
      border-top: 1px solid #222;
      padding-top: 20px;
      text-align: center;
      color: #777;
      font-size: 12px;
    }

    /* WHATSAPP */
    .whatsapp {
      position: fixed;
      right: 22px;
      bottom: 22px;
      width: 58px;
      height: 58px;
      background: #25D366;
      color: white;
      border-radius: 50%;
      display: grid;
      place-items: center;
      font-size: 27px;
      z-index: 999;
      box-shadow: 0 5px 20px rgba(0,0,0,.25);
      transition: 0.3s;
    }

    .whatsapp:hover {
      transform: scale(1.1);
    }

    /* ANIMATION */
    .reveal {
      opacity: 0;
      transform: translateY(30px);
      transition: 0.7s ease;
    }

    .reveal.active {
      opacity: 1;
      transform: translateY(0);
    }

    /* RESPONSIVE */
    @media (max-width: 900px) {
      nav ul {
        position: absolute;
        top: 78px;
        left: 0;
        width: 100%;
        background: var(--black);
        flex-direction: column;
        align-items: center;
        gap: 20px;
        padding: 30px 0;
        display: none;
      }

      nav ul.active {
        display: flex;
      }

      .menu-btn {
        display: block;
      }

      .about-grid,
      .contact-grid {
        grid-template-columns: 1fr;
      }

      .products-grid,
      .testimonial-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .features-grid {
        grid-template-columns: repeat(3, 1fr);
      }

      .about-image {
        max-width: 600px;
      }

      .about-badge {
        right: 15px;
      }
    }

    @media (max-width: 600px) {
      .section {
        padding: 70px 0;
      }

      .hero h1 {
        font-size: 52px;
      }

      .products-grid,
      .testimonial-grid,
      .features-grid,
      .footer-grid {
        grid-template-columns: 1fr;
      }

      .hero-buttons {
        flex-direction: column;
        align-items: flex-start;
      }

      .btn {
        width: 100%;
        text-align: center;
      }

      .about-content h2,
      .contact-info h2 {
        font-size: 40px;
      }

      .price-table th,
      .price-table td {
        padding: 14px 10px;
        font-size: 11px;
      }

      .price-header {
        padding: 20px;
      }

      .contact-info {
        padding: 30px;
      }
    }
  </style>
</head>

